{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxhillaert/attenza-integrations/blob/main/schemas/intervention.schema.json",
  "title": "Attenza MCP intervention",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "source", "message_id", "a2ui_messages"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "source": { "type": "string", "minLength": 1, "maxLength": 120 },
    "message_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "context_id": { "type": ["string", "null"], "maxLength": 200 },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Absolute timezone-aware decision deadline, at most seven days ahead."
    },
    "expires_in_seconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 604800 },
    "a2ui_messages": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "object" }
    }
  },
  "not": { "required": ["expires_at", "expires_in_seconds"] }
}
